# Local development
ENVIRONMENT=development
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@healthbot.local
ADMIN_PASSWORD=change-this-password

# Production: Render injects DATABASE_URL from managed PostgreSQL.
DATABASE_URL=
DATABASE_PATH=data/app.db

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

# Same-origin deployment does not need CORS. Add explicit origins only when
# frontend and API are hosted on different domains.
CORS_ORIGINS=

LOG_LEVEL=INFO
